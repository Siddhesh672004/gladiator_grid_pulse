{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gridpulse-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/gridpulse-web",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": [
              "src/material-theme.css",
              "src/styles/tokens.css",
              "src/styles/base.css",
              "src/styles/components.css",
              "src/styles/pages/landing.css",
              "src/styles/pages/how-it-works.css",
              "src/styles/pages/auth.css",
              "src/styles/pages/error.css",
              "src/styles/pages/home.css",
              "src/styles/pages/profile.css",
              "src/styles/pages/booking.css",
              "src/styles/pages/feedback.css",
              "src/styles/pages/dashboard.css",
              "src/styles/pages/stats.css",
              "src/styles/pages/admin.css",
              "src/styles/pages/live-boards.css",
              "src/styles/pages/navigation.css",
              "src/styles/pages/footer.css",
              "src/styles/pages/auth-shell.css",
              "src/styles/pages/logo.css",
              "src/styles/pages/pictures.css",
              "src/styles/pages/chat.css",
              "src/styles/pages/shell.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "600kb", "maximumError": "1mb" },
                { "type": "anyComponentStyle", "maximumWarning": "6kb", "maximumError": "12kb" }
              ],
              "fileReplacements": [
                { "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" }
              ],
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 8081
          },
          "configurations": {
            "production": { "browserTarget": "gridpulse-web:build:production" },
            "development": { "browserTarget": "gridpulse-web:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": ["src/assets"],
            "styles": [
              "src/material-theme.css",
              "src/styles/tokens.css",
              "src/styles/base.css",
              "src/styles/components.css",
              "src/styles/pages/landing.css",
              "src/styles/pages/how-it-works.css",
              "src/styles/pages/auth.css",
              "src/styles/pages/error.css",
              "src/styles/pages/home.css",
              "src/styles/pages/profile.css",
              "src/styles/pages/booking.css",
              "src/styles/pages/feedback.css",
              "src/styles/pages/dashboard.css",
              "src/styles/pages/stats.css",
              "src/styles/pages/admin.css",
              "src/styles/pages/live-boards.css",
              "src/styles/pages/navigation.css",
              "src/styles/pages/footer.css",
              "src/styles/pages/auth-shell.css",
              "src/styles/pages/logo.css",
              "src/styles/pages/pictures.css",
              "src/styles/pages/chat.css",
              "src/styles/pages/shell.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
