# copy to secrets.properties in the repo root (never pushed) and fill in what you have, empty = that feature is off
# an environment variable with the same name wins over this file

# database: remove the # only to change a default (an empty value is NOT the default)
# mysql login, docker compose: DB_PASSWORD = MYSQL_ROOT_PASSWORD of .env
# DB_USERNAME=root
# required: the mysql password (no default)
DB_PASSWORD=
# where mysql runs, used when DB_URL is not set
# DB_HOST=localhost
# DB_PORT=3306
# a full jdbc url instead of host + port (azure)
# DB_URL=

# 64+ random characters, same value on every instance and service
JWT_SECRET=

# signs the e-ticket codes (QR), 32+ random characters, keep it secret; empty = a dev secret + warning
TICKET_SECRET=

# the services call each other's /internal/** with this key, 32+ random characters, the same in every service
INTERNAL_API_KEY=

# gmail that notification-service sends every email with: the address + an app password
# (Google Account -> Security -> App passwords)
MAIL_USERNAME=
MAIL_PASSWORD=

# the one super admin account, created / updated on every start (password: 8+ characters)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# chatbot (Google AI Studio), up to 3 keys, the next one is used when a key runs out
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# feedback sentiment labels (console.groq.com)
GROQ_API_KEY=

# payments, TEST mode keys rzp_test_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# track pictures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
