# one image per service:  docker build -f docker/Dockerfile.service --build-arg MODULE=springapp .
# (compose does this with the "apps" profile). the build context is the repo root, see .dockerignore
FROM maven:3.9-eclipse-temurin-17 AS build
ARG MODULE
WORKDIR /src
COPY pom.xml .
COPY common common
COPY springapp springapp
COPY notification-service notification-service
# the service + what it needs (common); the maven cache survives between builds
RUN --mount=type=cache,target=/root/.m2 mvn -q -B -pl ${MODULE} -am package -DskipTests \
    && cp ${MODULE}/target/*.jar /app.jar

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
