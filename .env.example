# copy to .env (docker compose reads it). put the same password in secrets.properties (repo root) as DB_PASSWORD
# required, choose your own
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# only for "docker compose --profile apps": the services in containers read these (the same keys as secrets.properties)
JWT_SECRET=
TICKET_SECRET=
INTERNAL_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
