# the public front door: https certificates (automatic), the angular site, and /api passed to the gateway
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy gateway:8080 {
			# the gateway trusts the first X-Forwarded-For entry, so only the real visitor address goes in
			header_up X-Forwarded-For {remote_host}
			# live boards are server-sent events: pass every chunk on at once
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://*.razorpay.com; frame-src https://*.razorpay.com; connect-src 'self' https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://upload.wikimedia.org https://*.razorpay.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# file names of the build carry a hash, so they can be cached for a year; index.html never is
	@hashed path_regexp \.[0-9a-f]{16,}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@index path / /index.html
	header @index Cache-Control "no-cache"
}
