# production secrets: copy to /opt/gridpulse/.env on the vm, fill in, never commit the filled file
# random values: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-64

# --- site ---
# the public name (duckdns subdomain), e.g. gridpulse.duckdns.org
DOMAIN=
# lets encrypt sends certificate notices here
ACME_EMAIL=
# github user/org that owns the images on ghcr.io, lower case
GHCR_OWNER=

# --- secrets shared by the services (64+ / 32+ random characters, never reuse the dev ones) ---
JWT_SECRET=
INTERNAL_API_KEY=
TICKET_SECRET=

# --- database (also the mysql root password of the container) ---
DB_PASSWORD=

# --- the one super admin, created on the first start ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- gmail that sends every email (address + app password) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- razorpay TEST mode keys (rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- track pictures ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ai (empty = the faq chat falls back to keyword answers, feedback stays unlabelled) ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
